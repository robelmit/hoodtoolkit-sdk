{
  "name": "@hoodtoolkit/pons",
  "version": "0.1.0",
  "description": "Pons V2 on Robinhood Chain: decode launches and trades, read a curve, quote a buy or a sell exactly, build the unsigned transaction and verify it before a wallet signs.",
  "license": "MIT",
  "keywords": [
    "robinhood-chain",
    "pons",
    "launchpad",
    "evm",
    "memecoin"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@hoodtoolkit/evm": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
