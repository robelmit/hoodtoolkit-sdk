{
  "name": "@hood-toolkit/evm",
  "version": "0.1.0",
  "description": "A small EVM JSON-RPC client and ABI helpers for Robinhood Chain: paced, retrying, with log ranges the public endpoint will serve. No dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robelmit/hoodtoolkit-sdk.git",
    "directory": "packages/evm"
  },
  "homepage": "https://github.com/robelmit/hoodtoolkit-sdk/tree/main/packages/evm#readme",
  "bugs": {
    "url": "https://github.com/robelmit/hoodtoolkit-sdk/issues"
  },
  "keywords": [
    "robinhood-chain",
    "pons",
    "launchpad",
    "evm",
    "memecoin"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
